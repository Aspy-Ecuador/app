APP_NAME=Aspy
# local en tu máquina; production en el servidor
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
# true solo en local. En producción SIEMPRE false (si no, los errores muestran datos internos)
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Base de datos ─────────────────────────────────────────────
# Opción A (más simple para desarrollar): SQLite local
#   Deja solo DB_CONNECTION=sqlite y borra las demás líneas DB_*;
#   Laravel usará database/database.sqlite (no se sube a git).
# Opción B: PostgreSQL (la que usa producción en Railway)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aspy
DB_USERNAME=postgres
DB_PASSWORD=

# ── Seguridad ─────────────────────────────────────────────────
# Minutos de validez del token de sesión (por defecto 7 días)
SANCTUM_EXPIRATION=10080
