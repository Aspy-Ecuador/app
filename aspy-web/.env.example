# URL de la API de Laravel (en producción: la URL pública del backend + /api)
VITE_API_URL=http://127.0.0.1:8000/api

# Sanity (contenido editable de la landing). Si no se definen, la web usa el contenido local.
# ID del proyecto: sanity.io/manage → tu proyecto. Es público (no es un secreto).
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
